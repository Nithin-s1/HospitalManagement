{
  "name": "@hospital/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed API client for the Hospital Management System",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
